{
  "name": "tg-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5",
    "@capacitor/core": "8.5",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.5",
    "@capacitor/share": "^8.0.3",
    "@zip.js/zip.js": "^2.23.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "lottie-web": "^5.13.0",
    "ogg-opus-decoder": "^1.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.10.0",
    "electron-builder": "26.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "main": "electron/main.cjs",
  "description": "Архив чатов: просмотр экспорта Telegram",
  "author": "alikhan",
  "build": {
    "appId": "app.chatarchive.viewer",
    "productName": "Архив чатов",
    "executableName": "ChatArchive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Архив чатов",
      "artifactName": "ChatArchive-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "ChatArchive-windows-portable.${ext}"
    }
  }
}
